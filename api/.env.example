# Copie este arquivo para ".env" e preencha os valores. O ".env" NÃO vai para o GitHub.

# Conexão com o Postgres (Supabase: botão "Connect" > Direct > Session pooler).
# Troque [YOUR-PASSWORD] pela senha do banco, SEM os colchetes.
# Na hospedagem (Vercel), use a mesma URL trocando a porta 5432 por 6543 (Transaction pooler).
DATABASE_URL=

# Porta da API (no computador)
PORT=3333

# Máximo de conexões com o banco. No computador: 10. Na Vercel: 3.
DB_POOL_MAX=10

# Endereço(s) do site que podem chamar a API (separe por vírgula; * é curinga)
# Na Vercel: https://gatosdefrancisca.vercel.app,https://cat-shelter-website-project-*-alanis-hadamas-projects.vercel.app
WEB_ORIGIN=http://localhost:3000

# URL do projeto Supabase (Project Settings > Data API > Project URL). Ex.: https://xxxx.supabase.co
SUPABASE_URL=

# Chave secreta do Supabase (Project Settings > API Keys > Secret keys).
# Só para os scripts no SEU computador (ex.: npm run users:grant). NUNCA coloque na Vercel nem no site.
SUPABASE_SECRET_KEY=

# Endereço do site usado no link dos convites por e-mail
SITE_URL=http://localhost:3000
