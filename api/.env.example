# Copie este arquivo para ".env" e preencha os valores. O ".env" NÃO vai para o GitHub.

# Conexão com o Postgres.
# Supabase: Project Settings > Database > Connection string > "Session pooler" (funciona em IPv4)
# Exemplo local: postgresql://postgres:postgres@localhost:5432/gatos
DATABASE_URL=

# Porta da API
PORT=3333

# Endereço(s) do site que podem chamar a API (separe por vírgula)
WEB_ORIGIN=http://localhost:3000
